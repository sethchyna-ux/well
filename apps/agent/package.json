{
  "name": "@well/local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, approval-gated coding agent powered by LM Studio",
  "bin": {
    "well-agent": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lmstudio/sdk": "2.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
